<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <meta name="description" content="Cadastre-se no Senac Transcreve para acessar a transcrição de voz em tempo real.">

  <meta name="theme-color" content="#ff7824">

  <title>Cadastrar | Senac Transcreve</title>

  <link rel="icon" type="image/png" href="/img/logo.png">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/login.css">
</head>

<body>

  <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

  <header class="cabecalho">
    <div class="container cabecalho-conteudo">

      <a class="logo" href="index.html" aria-label="Senac Transcreve, início">
        <img class="logo-imagem" src="img/logo.png" alt="Ícone Senac Transcreve">
        <span>Transcreve</span>
      </a>

      <nav class="menu" aria-label="Navegação principal">
        <a href="index.html">Início</a>
        <a href="aula.html">Aula</a>
        <a href="login.html">Entrar</a>
      </nav>

    </div>
  </header>

  <main id="conteudo" class="secao-login">

    <div class="container login-container">

      <div class="login-titulo">
        <h1>Criar sua conta</h1>
        <p>Preencha seus dados para acessar as aulas.</p>
      </div>

      <div class="card-login">

        <form id="form-cadastro" novalidate>

          <p id="mensagem" class="login-mensagem" role="alert" hidden></p>

          <div class="campo">
            <label for="nome">Nome</label>
            <input
              type="text"
              id="nome"
              name="nome"
              placeholder="Pedro Guilherme"
              autocomplete="name"
              required
              aria-describedby="erro-nome"
            >
          </div>

          <div class="campo">
            <label for="email">E-mail</label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="voce@exemplo.com"
              autocomplete="email"
              required
              aria-describedby="erro-email"
            >
          </div>

          <div class="campo">
            <label for="senha">Senha</label>

            <div class="campo-senha">
              <input
                type="password"
                id="senha"
                name="senha"
                placeholder="Digite sua senha"
                autocomplete="new-password"
                required
                minlength="6"
                aria-describedby="erro-senha"
              >

              <button
                type="button"
                class="btn-mostrar"
                aria-controls="senha"
                aria-pressed="false"
              >Mostrar</button>
            </div>
          </div>

          <div class="campo">
            <label for="senha2">Confirme sua senha</label>

            <div class="campo-senha">
              <input
                type="text"
                id="senha2"
                name="senha2"
                placeholder="Confirme sua senha"
                autocomplete="new-password"
                required
                minlength="6"
                aria-describedby="erro-senha2"
              >
            </div>
          </div>

          <button
            type="submit"
            class="btn btn-principal btn-largo"
            id="botao-cadastrar"
          >Cadastrar</button>

        </form>

      </div>

      <p class="login-rodape">
        Já possui uma conta?<a class="link" href="login">Entrar</a>
      </p>

    </div>

  </main>

  <footer>
    <div class="container rodape-conteudo">
      <strong>Senac Transcreve</strong>
      <p>Educação acessível para todos.</p>
    </div>
  </footer>

  <script>
    const formulario = document.getElementById("form-cadastro");
    const mostraSenha = document.querySelector(".btn-mostrar")

    mostraSenha.addEventListener('click', () => {
      const alternar = document.getElementById("senha");
      if(alternar.type === "password"){
        alternar.type = "text";
        mostraSenha.textContent = "Esconder";
      } else {
        alternar.type = "password";
        mostraSenha.textContent = "Mostrar";
      }
    })

    formulario.addEventListener('submit', async (event) => {
      event.preventDefault();

      const nome = document.getElementById("nome").value;
      const email = document.getElementById("email").value;
      const senha = document.getElementById("senha").value;
      const senha2 = document.getElementById("senha2");
      const mensagem = document.getElementById("mensagem");
      const botao = document.getElementById("botao-cadastrar");

      if(senha2.value !== senha){
        mensagem.hidden = false
        mensagem.textContent += "A Senhas não batem, elas são diferentes";
        senha2.focus()
        return;
      }

      botao.disabled = true

      try {
        mensagem.textContent = ''

        const resposta = await fetch("/api/cadastro", {
          method: "POST",
          headers: {
            "Content-type": "application/json",
          },
          body: JSON.stringify({ nome, email, senha })
        });

        const dados = await resposta.json()

        if(!resposta.ok){
          mensagem.hidden = false
          mensagem.textContent = dados.erro || "Erro ao cadastra, Tente mais tarde";
          botao.disabled = false
          return;
        }
        window.location.href = "/aula.html"
      } catch (erro) {
        mensagem.textContent = erro.message
        botao.disabled = false
      }
    })
  </script>
</body>
</html>
# Copie este arquivo para .env e ajuste usuário, senha, host e nome do banco.
# Caracteres especiais na senha devem estar percent-encoded na URL (@ = %40, # = %23, / = %2F, : = %3A).
# Atenção: a porta padrão do MySQL é 3306 (5432 é a do PostgreSQL).
DATABASE_URL="mysql://usuario:senha@localhost:3306/projeto_integrador"
PORT=3000

# Segredo usado para assinar o cookie de login (mínimo de 32 caracteres).
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem ele, em desenvolvimento os logins caem a cada reinício do servidor; em produção o servidor não inicia.
SESSION_SECRET=""

# Se o site rodar atrás de um proxy (Nginx, Render, Railway...), use TRUST_PROXY=1
# para o limite de tentativas de login enxergar o IP real de cada visitante.
# TRUST_PROXY=1

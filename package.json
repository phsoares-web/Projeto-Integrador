    "express": "^5.1.0",
    "mariadb": "^3.4.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.3",
    "@types/node": "^22.20.5",
    "dotenv": "^18.0.7",
    "prisma": "^7.10.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
